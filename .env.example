# ===== Mentalaba AI Frontend =====
# Backend (aiagent) API manzili — chat-store shu URL ga so'rov yuboradi.
# Build vaqtida Next.js tomonidan almashtiriladi (NEXT_PUBLIC_ prefiksi).
#
# Local dev: backend `npm run dev` (port 3000) da ishlasa:
NEXT_PUBLIC_API_URL=http://localhost:3000

# Production (Vercel) uchun — backend deploy qilingan URL:
# NEXT_PUBLIC_API_URL=https://BACKEND-XXX.vercel.app
#
# ⚠️ Eslatma: backend'dagi CORS_ALLOWED_ORIGINS ga ham shu frontend URL'ini
# qo'shish kerak (middleware.ts shu ro'yxatdan o'tkazadi).
